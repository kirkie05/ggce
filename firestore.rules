rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All registration and ticket access goes through trusted Cloud Functions.
    match /registrations/{document=**} { allow read, write: if false; }
    match /tickets/{document=**} { allow read, write: if false; }
    match /rateLimits/{document=**} { allow read, write: if false; }
  }
}
